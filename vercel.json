{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "rewrites": [
    { "source": "/r16", "destination": "/" },
    { "source": "/r8", "destination": "/" },
    { "source": "/r4", "destination": "/" },
    { "source": "/final", "destination": "/" },
    { "source": "/result/:tag", "destination": "/" },
    { "source": "/with/:index", "destination": "/" }
  ]
}
